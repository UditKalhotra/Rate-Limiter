PORT=4000
MONGO_URI=mongodb://localhost:27017/rategate

# Signs and verifies login JWTs. Use a long random string in production.
JWT_SECRET=suckmydickubigblack
# How long a login session lasts before the user is forced to log in again.
JWT_EXPIRES_IN=2h

# Used to encrypt/decrypt API keys so the "reveal" button in the dashboard
# can show the original key again. Use a long random string (32+ chars) in
# production, e.g. `openssl rand -hex 32`.
API_KEY_SECRET=replace-with-a-long-random-string
